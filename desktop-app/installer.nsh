; Surge Listings — Custom NSIS Setup Wizard Definitions

!macro customHeader
  !define MUI_WELCOMEPAGE_TITLE "Surge Listings Desktop Setup"
  !define MUI_WELCOMEPAGE_TEXT "Welcome to the Surge Listings Setup Wizard.$\r$\n$\r$\nThis wizard installs the official Surge Listings desktop application on your computer.$\r$\n$\r$\nSurge Listings provides a dedicated, secure institutional workspace for managing bank-repossessed and distressed asset dispositions in Ghana.$\r$\n$\r$\nClick Next to select an installation location and begin."
  !define MUI_FINISHPAGE_TITLE "Surge Listings Installed Successfully"
  !define MUI_FINISHPAGE_TEXT "Surge Listings is ready to use.$\r$\n$\r$\nShortcuts have been created on your Desktop and in the Windows Start Menu for quick access."
  !define MUI_FINISHPAGE_RUN_TEXT "Launch Surge Listings"
!macroend

