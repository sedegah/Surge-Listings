{
  "name": "surge-listings-desktop",
  "version": "1.0.0",
  "description": "Surge Listings - Institutional Asset Disposition Desktop Application",
  "main": "main.cjs",
  "author": "Surge Solutions",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.surgesolutions.listings",
    "productName": "Surge Listings",
    "copyright": "Copyright © 2026 Surge Solutions",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "offline.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Surge-Listings-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Surge Listings",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "assets/installerSidebar.bmp",
      "uninstallerSidebar": "assets/uninstallerSidebar.bmp",
      "installerHeader": "assets/installerHeader.bmp",
      "installerHeaderIcon": "assets/icon.ico",
      "include": "installer.nsh",
      "uninstallDisplayName": "Surge Listings",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}
