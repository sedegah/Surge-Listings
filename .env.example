# Vercel runtime: Cloudflare D1 REST access (use a least-privilege token).
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-d1-api-token
CLOUDFLARE_D1_DATABASE_ID=replace-with-d1-database-id

# Vercel runtime: Cloudflare R2 S3-compatible access.
R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ASSETS_BUCKET=surge-assets
R2_DOCUMENTS_BUCKET=surge-documents
R2_TITLE_DOCUMENTS_BUCKET=surge-title-documents
R2_LAND_SEARCHES_BUCKET=surge-land-searches
R2_VALUATION_REPORTS_BUCKET=surge-valuation-reports
R2_LEGAL_INSTRUMENTS_BUCKET=surge-legal-instruments
R2_KYC_DOCUMENTS_BUCKET=surge-kyc-documents

# Public URL used by Vercel when it records a marketplace photo URL.
PUBLIC_API_URL=https://surge-solutions-api.sedegahkimathi.workers.dev
